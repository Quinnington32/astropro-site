{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astropro-student-resource-center",
  "account_id": "604bc8f6fd70f62522869abae693396b",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "students.goastropro.com",
      "custom_domain": true,
    },
    {
      "pattern": "astropromarketing.com/studentresourcecenter",
      "zone_name": "astropromarketing.com",
    },
    {
      "pattern": "astropromarketing.com/studentresourcecenter/*",
      "zone_name": "astropromarketing.com",
    },
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "astropro-student-resource-center",
      "database_id": "c4a3ed6f-7f10-490e-9c09-d3db46448850",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "GHL_LOCATION_ID": "R0dwEE59yxdgMTqUvP8s",
    "GHL_PIPELINE_ID": "xZZMaxB1X5CISlfDFdCR",
    "GHL_LISTING_STAGE_ID": "564240e3-f673-4a32-8679-591561962f0b",
    "GHL_CAMPAIGN_STAGE_ID": "69d130ab-b560-45bf-a1f6-62484806b601",
    "GHL_LISTING_OWNER_ID": "p7xCOyezOj1Ul9Lfm4HD",
    "GHL_CAMPAIGN_OWNER_ID": "UJ4Dqndx2QMSRwy63Fkz",
  },
  "triggers": {
    "crons": ["17 4 * * *", "*/5 * * * *"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
}
