{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astropro-student-resource-center",
  "account_id": "a136159183b5429d638ed0cfc170fe1f",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "astroprostudentresourcecenter.com", "custom_domain": true },
    { "pattern": "www.astroprostudentresourcecenter.com", "custom_domain": true },
    { "pattern": "astroprostudentresourcecenter.org", "custom_domain": true },
    { "pattern": "www.astroprostudentresourcecenter.org", "custom_domain": true },
  ],
  "send_email": [{ "name": "EMAIL" }],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "astropro-student-resource-center",
      "database_id": "4f5a15b1-b24a-469e-9f9e-e5cb8f09c224",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": {
    "crons": ["17 4 * * *"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
}
